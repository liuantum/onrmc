// onrmc — multi-tenant schema. Every business table carries tenantId.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── SaaS layer ─────────────────────────

model Plan {
  id            String                @id @default(cuid())
  name          String                @unique
  priceMonthly  Decimal               @db.Decimal(12, 2)
  priceYearly   Decimal               @db.Decimal(12, 2)
  maxPlants     Int                   @default(1)
  maxUsers      Int                   @default(10)
  maxVehicles   Int                   @default(10)
  features      String[] // e.g. ["gps","owner_app","analytics"]
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  subscriptions Subscription[]
  payments      SubscriptionPayment[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  gstin     String?
  stateCode String // 2-digit GST state code, e.g. "36" Telangana
  address   String?
  city      String?
  pincode   String? // 6-digit PIN, required for e-invoice / e-way bill
  phone     String?
  email     String?
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  subscriptions        Subscription[]
  users                User[]
  plants               Plant[]
  customers            Customer[]
  suppliers            Supplier[]
  materials            Material[]
  mixDesigns           MixDesign[]
  vehicles             Vehicle[]
  orders               Order[]
  invoices             Invoice[]
  payments             Payment[]
  accounts             Account[]
  journals             Journal[]
  numberSeries         NumberSeries[]
  auditLogs            AuditLog[]
  einvoiceSettings     EinvoiceSettings?
  subscriptionPayments SubscriptionPayment[]
  subscriptionInvoices SubscriptionInvoice[]
  creditDebitNotes     CreditDebitNote[]
  ewayBills            EwayBill[]
}

model Subscription {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIAL)
  billingCycle String             @default("MONTHLY") // MONTHLY | YEARLY
  startsAt     DateTime           @default(now())
  endsAt       DateTime
  createdAt    DateTime           @default(now())

  @@index([tenantId])
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  ACCOUNTANT
  SALES
  STORE
  BATCHING
  DISPATCH
  DRIVER
}

model User {
  id           String   @id @default(cuid())
  tenantId     String? // null only for SUPER_ADMIN
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  name         String
  phone        String   @unique
  email        String?
  passwordHash String
  role         Role
  plantId      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  driverTrips Challan[] @relation("DriverTrips")

  @@index([tenantId])
}

model Plant {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  address           String?
  pincode           String?
  lat               Float?
  lng               Float?
  capacityM3PerHour Decimal? @db.Decimal(8, 2)

  stock    Stock[]
  batches  Batch[]
  receipts MaterialReceipt[]

  @@index([tenantId])
}

// ───────────────────────── Masters ─────────────────────────

model Customer {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  gstin          String?
  stateCode      String
  phone          String?
  email          String?
  billingAddress String?
  city           String?
  pincode        String?
  creditLimit    Decimal  @default(0) @db.Decimal(14, 2)
  creditDays     Int      @default(30)
  accountId      String?  @unique
  account        Account? @relation(fields: [accountId], references: [id])
  createdAt      DateTime @default(now())

  sites            Site[]
  orders           Order[]
  invoices         Invoice[]
  creditDebitNotes CreditDebitNote[]
  payments         Payment[]
  rates            CustomerRate[]

  @@index([tenantId, name])
}

model Site {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  name       String
  address    String?
  city       String?
  pincode    String?
  stateCode  String
  lat        Float?
  lng        Float?
  contact    String?
  orders     Order[]

  @@index([tenantId])
}

model Supplier {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  name             String
  gstin            String?
  phone            String?
  email            String?
  address          String?
  city             String?
  pincode          String?
  /// GST state code; defaults to the GSTIN prefix. Decides CGST+SGST vs IGST on bills.
  stateCode        String?
  paymentTermsDays Int                 @default(30)
  /// Amount owed to the supplier when they were added (posted once: Dr Capital / Cr supplier).
  openingBalance   Decimal             @default(0) @db.Decimal(14, 2)
  /// Unregistered suppliers / GTA freight: GST paid by us under reverse charge by default.
  rcmDefault       Boolean             @default(false)
  accountId        String?             @unique
  account          Account?            @relation(fields: [accountId], references: [id])
  receipts         MaterialReceipt[]
  bills            PurchaseBill[]
  payments         SupplierPayment[]
  debitNotes       SupplierDebitNote[]

  @@index([tenantId])
}

enum MaterialKind {
  CEMENT
  FLY_ASH
  GGBS
  AGGREGATE_10MM
  AGGREGATE_20MM
  SAND
  M_SAND
  ADMIXTURE
  WATER
  OTHER
}

model Material {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  name         String
  kind         MaterialKind
  unit         String // KG, TON, LTR, M3
  /// Weighted average cost per unit; updated on each receipt.
  avgCost      Decimal      @default(0) @db.Decimal(18, 6)
  reorderLevel Decimal      @default(0) @db.Decimal(14, 3)

  stock        Stock[]
  mixItems     MixDesignItem[]
  receiptLines MaterialReceiptLine[]
  consumption  BatchConsumption[]
  billLines    PurchaseBillLine[]

  @@unique([tenantId, name])
}

model Stock {
  id         String   @id @default(cuid())
  tenantId   String
  plantId    String
  plant      Plant    @relation(fields: [plantId], references: [id])
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Decimal  @default(0) @db.Decimal(14, 3)

  @@unique([plantId, materialId])
}

model MaterialReceipt {
  id             String                @id @default(cuid())
  tenantId       String
  plantId        String
  plant          Plant                 @relation(fields: [plantId], references: [id])
  supplierId     String
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  number         String
  supplierBillNo String?
  vehicleNo      String?
  receivedAt     DateTime              @default(now())
  amount         Decimal               @db.Decimal(14, 2)
  gstAmount      Decimal               @default(0) @db.Decimal(14, 2)
  lines          MaterialReceiptLine[]
  /// Purchase bill this receipt was matched to. Receipts posted before bills existed are `legacyPosted`
  /// (they credited the supplier directly) and are never billed again.
  billId         String?
  bill           PurchaseBill?         @relation(fields: [billId], references: [id])
  legacyPosted   Boolean               @default(false)

  @@unique([tenantId, number])
}

model MaterialReceiptLine {
  id         String          @id @default(cuid())
  receiptId  String
  receipt    MaterialReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  materialId String
  material   Material        @relation(fields: [materialId], references: [id])
  quantity   Decimal         @db.Decimal(14, 3)
  rate       Decimal         @db.Decimal(14, 4)
}

/// Concrete grade recipe per m³ (M20, M25, M30 ...).
model MixDesign {
  id       String          @id @default(cuid())
  tenantId String
  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  grade    String // M20, M25 ...
  name     String
  baseRate Decimal         @db.Decimal(12, 2) // default selling rate per m³
  gstRate  Decimal         @default(18) @db.Decimal(5, 2)
  hsn      String          @default("38245010")
  active   Boolean         @default(true)
  items    MixDesignItem[]
  orders   Order[]
  rates    CustomerRate[]

  @@unique([tenantId, grade, name])
}

model MixDesignItem {
  id          String    @id @default(cuid())
  mixDesignId String
  mixDesign   MixDesign @relation(fields: [mixDesignId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id])
  qtyPerM3    Decimal   @db.Decimal(12, 3)
}

model CustomerRate {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  mixDesignId String
  mixDesign   MixDesign @relation(fields: [mixDesignId], references: [id])
  rate        Decimal   @db.Decimal(12, 2)
  validFrom   DateTime  @default(now())

  @@index([customerId, mixDesignId])
}

enum VehicleType {
  TRANSIT_MIXER
  PUMP
  TIPPER
  OTHER
}

model Vehicle {
  id                   String                @id @default(cuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  number               String
  type                 VehicleType           @default(TRANSIT_MIXER)
  capacityM3           Decimal               @default(6) @db.Decimal(6, 2)
  lastLat              Float?
  lastLng              Float?
  lastSeenAt           DateTime?
  active               Boolean               @default(true)
  /// Latest odometer reading (km), updated from service records
  odometerKm           Int?
  challans             Challan[]
  gpsPoints            GpsPoint[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords   MaintenanceRecord[]

  @@unique([tenantId, number])
}

/// A recurring service task for one truck, due every N km and/or every N days, whichever comes first.
model MaintenanceSchedule {
  id         String              @id @default(cuid())
  tenantId   String
  vehicleId  String
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id])
  task       String // e.g. "Engine oil + filter", "Drum gearbox oil", "Tyre rotation", "Insurance renewal"
  everyKm    Int?
  everyDays  Int?
  lastDoneAt DateTime?
  lastDoneKm Int?
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now())
  records    MaintenanceRecord[]

  @@index([tenantId, vehicleId])
}

enum MaintenancePaidVia {
  CASH
  BANK
  /// Already booked through a supplier purchase bill: nothing is posted here, so it is not counted twice.
  PURCHASE_BILL
}

/// One service or repair done on a truck, with its cost. CASH/BANK post Dr Vehicle repairs (5310, an overhead) / Cr Cash or Bank.
model MaintenanceRecord {
  id           String               @id @default(cuid())
  tenantId     String
  number       String
  vehicleId    String
  vehicle      Vehicle              @relation(fields: [vehicleId], references: [id])
  scheduleId   String?
  schedule     MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])
  date         DateTime
  odometerKm   Int?
  description  String
  vendor       String?
  partsCost    Decimal              @default(0) @db.Decimal(12, 2)
  labourCost   Decimal              @default(0) @db.Decimal(12, 2)
  totalCost    Decimal              @db.Decimal(12, 2)
  paidVia      MaintenancePaidVia
  billRef      String?
  downtimeHrs  Decimal?             @db.Decimal(6, 1)
  createdById  String?
  createdAt    DateTime             @default(now())
  cancelledAt  DateTime?
  cancelReason String?

  @@unique([tenantId, number])
  @@index([tenantId, vehicleId, date])
}

// ───────────────────────── Operations ─────────────────────────

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  number       String
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  siteId       String
  site         Site        @relation(fields: [siteId], references: [id])
  mixDesignId  String
  mixDesign    MixDesign   @relation(fields: [mixDesignId], references: [id])
  quantityM3   Decimal     @db.Decimal(10, 2)
  rate         Decimal     @db.Decimal(12, 2)
  pumpRequired Boolean     @default(false)
  pumpCharge   Decimal     @default(0) @db.Decimal(12, 2)
  scheduledAt  DateTime
  status       OrderStatus @default(CONFIRMED)
  notes        String?
  createdAt    DateTime    @default(now())
  batches      Batch[]
  challans     Challan[]

  @@unique([tenantId, number])
  @@index([tenantId, scheduledAt])
}

/// One batching cycle at the plant. Actual consumption is recorded per material.
model Batch {
  id           String             @id @default(cuid())
  tenantId     String
  plantId      String
  plant        Plant              @relation(fields: [plantId], references: [id])
  orderId      String
  order        Order              @relation(fields: [orderId], references: [id])
  number       String
  quantityM3   Decimal            @db.Decimal(8, 2)
  batchedAt    DateTime           @default(now())
  operatorId   String?
  /// Set when a batch entered by mistake is cancelled: stock is restored and the cost posting reversed.
  cancelledAt  DateTime?
  cancelReason String?
  consumption  BatchConsumption[]
  challan      Challan?
  cubeSets     CubeSet[]

  @@unique([tenantId, number])
}

/// Cubes cast from one batch (usually 3 per test age), with fresh-concrete checks at the plant.
model CubeSet {
  id          String       @id @default(cuid())
  tenantId    String
  number      String
  batchId     String
  batch       Batch        @relation(fields: [batchId], references: [id])
  /// Grade copied at sampling so later mix changes don't alter the record (e.g. "M25").
  grade       String
  fck         Decimal      @db.Decimal(5, 1)
  sampledAt   DateTime
  slumpMm     Int?
  tempC       Decimal?     @db.Decimal(4, 1)
  cubeSizeMm  Int          @default(150)
  sampledById String?
  notes       String?
  createdAt   DateTime     @default(now())
  results     CubeResult[]

  @@unique([tenantId, number])
  @@index([tenantId, sampledAt])
}

/// One crushed cube. Strength (N/mm²) = load (kN) × 1000 / (side × side).
model CubeResult {
  id          String   @id @default(cuid())
  cubeSetId   String
  cubeSet     CubeSet  @relation(fields: [cubeSetId], references: [id], onDelete: Cascade)
  ageDays     Int
  testedAt    DateTime
  cubeNo      Int
  weightKg    Decimal? @db.Decimal(6, 3)
  loadKn      Decimal  @db.Decimal(8, 1)
  strengthMpa Decimal  @db.Decimal(6, 2)
  testedById  String?
  remarks     String?
  createdAt   DateTime @default(now())

  @@unique([cubeSetId, ageDays, cubeNo])
}

model BatchConsumption {
  id         String   @id @default(cuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  designQty  Decimal  @db.Decimal(12, 3)
  actualQty  Decimal  @db.Decimal(12, 3)
  /// Cost snapshot at batching time (avgCost × actualQty) — used for owner margin analytics.
  cost       Decimal  @db.Decimal(14, 2)
}

/// Delivery challan = one truck trip. Invoice quantities come from here.
model Challan {
  id           String       @id @default(cuid())
  tenantId     String
  number       String
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id])
  batchId      String?      @unique
  batch        Batch?       @relation(fields: [batchId], references: [id])
  vehicleId    String
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  driverId     String?
  driver       User?        @relation("DriverTrips", fields: [driverId], references: [id])
  quantityM3   Decimal      @db.Decimal(8, 2)
  status       String       @default("ASSIGNED") // see TRIP_STATES in @onrmc/shared
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  podName      String?
  podPhotoUrl  String?
  dieselCost   Decimal      @default(0) @db.Decimal(10, 2)
  invoiceLine  InvoiceLine?
  gpsPoints    GpsPoint[]
  ewayBills    EwayBill[]
  createdAt    DateTime     @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model GpsPoint {
  id         BigInt   @id @default(autoincrement())
  tenantId   String
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  challanId  String?
  challan    Challan? @relation(fields: [challanId], references: [id])
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  recordedAt DateTime

  @@index([vehicleId, recordedAt])
}

// ───────────────────────── Billing ─────────────────────────

enum InvoiceType {
  TAX_INVOICE // GST applied (CGST+SGST or IGST)
  BILL_OF_SUPPLY // non-GST document where GST does not apply
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  type          InvoiceType         @default(TAX_INVOICE)
  number        String
  customerId    String
  customer      Customer            @relation(fields: [customerId], references: [id])
  placeOfSupply String // state code
  interState    Boolean
  issueDate     DateTime            @default(now())
  dueDate       DateTime
  status        InvoiceStatus       @default(DRAFT)
  taxable       Decimal             @db.Decimal(14, 2)
  cgst          Decimal             @default(0) @db.Decimal(14, 2)
  sgst          Decimal             @default(0) @db.Decimal(14, 2)
  igst          Decimal             @default(0) @db.Decimal(14, 2)
  roundOff      Decimal             @default(0) @db.Decimal(6, 2)
  total         Decimal             @db.Decimal(14, 2)
  paid          Decimal             @default(0) @db.Decimal(14, 2)
  /// Net effect of credit/debit notes on what the customer owes: + debit notes, − credit applied.
  /// Balance due = total + noteAdj − paid.
  noteAdj       Decimal             @default(0) @db.Decimal(14, 2)
  notes         String?
  cancelReason  String?
  createdById   String
  createdAt     DateTime            @default(now())
  lines         InvoiceLine[]
  allocations   PaymentAllocation[]

  // e-invoice (IRN from the Invoice Registration Portal)
  einvoiceStatus   EinvoiceStatus    @default(NOT_REQUIRED)
  irn              String?           @unique
  ackNo            String?
  ackDate          DateTime?
  signedQr         String?           @db.Text
  signedInvoice    String?           @db.Text
  einvoiceError    String?
  irnCancelledAt   DateTime?
  irnCancelReason  String?
  ewayBills        EwayBill[]
  creditDebitNotes CreditDebitNote[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, status])
}

enum EinvoiceStatus {
  NOT_REQUIRED // bill of supply, B2C, or e-invoicing switched off
  PENDING
  GENERATED
  CANCELLED
  FAILED
}

enum GspProvider {
  MOCK
  CLEARTAX
  MASTERS_INDIA
  NIC_DIRECT
}

enum EwayBillStatus {
  ACTIVE
  CANCELLED
}

/// Per-tenant e-invoice / e-way bill settings. Credentials are AES-GCM encrypted
/// with EINVOICE_ENC_KEY and never sent to the client.
model EinvoiceSettings {
  id              String      @id @default(cuid())
  tenantId        String      @unique
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  einvoiceEnabled Boolean     @default(false)
  ewaybillEnabled Boolean     @default(false)
  provider        GspProvider @default(MOCK)
  credentialsEnc  String?     @db.Text
  updatedAt       DateTime    @updatedAt
}

model EwayBill {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  invoiceId    String
  invoice      Invoice        @relation(fields: [invoiceId], references: [id])
  challanId    String?
  challan      Challan?       @relation(fields: [challanId], references: [id])
  ewbNo        String
  ewbDate      DateTime
  validUpto    DateTime?
  vehicleNo    String?
  transMode    String         @default("1") // 1 road, 2 rail, 3 air, 4 ship
  distanceKm   Int
  status       EwayBillStatus @default(ACTIVE)
  cancelReason String?
  cancelledAt  DateTime?
  raw          Json?
  createdAt    DateTime       @default(now())

  @@unique([tenantId, ewbNo])
  @@index([invoiceId])
}

model InvoiceLine {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Concrete lines must reference the delivery challan they bill.
  challanId   String?    @unique
  challan     Challan?   @relation(fields: [challanId], references: [id])
  description String
  hsn         String
  quantity    Decimal    @db.Decimal(10, 2)
  unit        String     @default("M3")
  rate        Decimal    @db.Decimal(12, 2)
  gstRate     Decimal    @db.Decimal(5, 2)
  taxable     Decimal    @db.Decimal(14, 2)
  tax         Decimal    @db.Decimal(14, 2)
  total       Decimal    @db.Decimal(14, 2)
  noteLines   NoteLine[]
}

enum NoteType {
  CREDIT
  DEBIT
}

enum NoteReason {
  RATE_DIFFERENCE // CN: rate reduced / DN: rate increased
  QUANTITY_RETURNED // CN: concrete returned / rejected at site
  SHORT_SUPPLY // CN: billed more than delivered
  POST_SUPPLY_DISCOUNT // CN: discount agreed after the sale
  IRN_CANCELLED_AFTER_24H // CN: full reversal of an e-invoice that can no longer be cancelled
}

enum NoteStatus {
  ISSUED
  CANCELLED
}

/// GST credit / debit note (s.34 CGST Act) against one issued invoice. Same place of supply and tax type
/// as the original. Never edited; cancelled with a reason, which reverses the ledger.
model CreditDebitNote {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  type          NoteType
  number        String
  invoiceId     String
  invoice       Invoice    @relation(fields: [invoiceId], references: [id])
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id])
  reason        NoteReason
  reasonText    String?
  /// true for returned / short-supplied quantity (changes billed m³); false for value-only notes
  quantityBased Boolean    @default(false)
  issueDate     DateTime   @default(now())
  placeOfSupply String
  interState    Boolean
  taxable       Decimal    @db.Decimal(14, 2)
  cgst          Decimal    @default(0) @db.Decimal(14, 2)
  sgst          Decimal    @default(0) @db.Decimal(14, 2)
  igst          Decimal    @default(0) @db.Decimal(14, 2)
  roundOff      Decimal    @default(0) @db.Decimal(6, 2)
  total         Decimal    @db.Decimal(14, 2)
  /// Credit notes: part applied against the invoice balance; the rest stays as customer credit.
  applied       Decimal    @default(0) @db.Decimal(14, 2)
  status        NoteStatus @default(ISSUED)
  cancelReason  String?
  createdById   String
  createdAt     DateTime   @default(now())
  lines         NoteLine[]

  einvoiceStatus  EinvoiceStatus @default(NOT_REQUIRED)
  irn             String?        @unique
  ackNo           String?
  ackDate         DateTime?
  signedQr        String?        @db.Text
  signedInvoice   String?        @db.Text
  einvoiceError   String?
  irnCancelledAt  DateTime?
  irnCancelReason String?

  @@unique([tenantId, number])
  @@index([tenantId, invoiceId])
}

model NoteLine {
  id            String          @id @default(cuid())
  noteId        String
  note          CreditDebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  invoiceLineId String
  invoiceLine   InvoiceLine     @relation(fields: [invoiceLineId], references: [id])
  description   String
  hsn           String
  /// quantity returned (quantity notes) or quantity the rate change applies to (rate notes); null for a lump-sum discount
  quantity      Decimal?        @db.Decimal(10, 2)
  unit          String
  rate          Decimal         @db.Decimal(12, 2)
  gstRate       Decimal         @db.Decimal(5, 2)
  taxable       Decimal         @db.Decimal(14, 2)
  tax           Decimal         @db.Decimal(14, 2)
  total         Decimal         @db.Decimal(14, 2)
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
}

model Payment {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  number      String
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id])
  amount      Decimal             @db.Decimal(14, 2)
  mode        PaymentMode
  reference   String?
  receivedAt  DateTime            @default(now())
  notes       String?
  allocations PaymentAllocation[]

  @@unique([tenantId, number])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal @db.Decimal(14, 2)
}

// ───────────────────────── Accounts (double entry) ─────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  code     String
  name     String
  type     AccountType
  group    String // Sundry Debtors, Bank, Duties & Taxes, Sales, Direct Expenses ...
  system   Boolean        @default(false)
  entries  JournalEntry[]
  customer Customer?
  supplier Supplier?

  @@unique([tenantId, code])
}

model Journal {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  date       DateTime       @default(now())
  narration  String
  sourceType String // INVOICE, INVOICE_CANCEL, PAYMENT, RECEIPT, BATCH, BATCH_CANCEL, OPENING_STOCK, EXPENSE, MANUAL
  sourceId   String?
  entries    JournalEntry[]

  @@index([tenantId, date])
}

model JournalEntry {
  id        String  @id @default(cuid())
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)

  @@index([accountId])
}

// ───────────────────────── System ─────────────────────────

model NumberSeries {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  key      String // e.g. "INV/26-27", "BOS/26-27", "DC/26-27"
  next     Int    @default(1)

  @@unique([tenantId, key])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  userId   String?
  action   String
  entity   String
  entityId String?
  data     Json?
  at       DateTime @default(now())

  @@index([tenantId, entity, entityId])
}

// ───────────────────────── Purchases / payables ─────────────────────────

enum PurchaseBillKind {
  MATERIAL // against goods receipts
  EXPENSE // services, freight, repairs… straight to an expense account
}

enum PurchaseBillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model PurchaseBill {
  id             String                      @id @default(cuid())
  tenantId       String
  number         String // internal: PB/26-27/0001
  supplierId     String
  supplier       Supplier                    @relation(fields: [supplierId], references: [id])
  supplierBillNo String
  billDate       DateTime
  dueDate        DateTime
  kind           PurchaseBillKind
  interState     Boolean
  /// GST paid by us under reverse charge (unregistered supplier / GTA): supplier is not paid the GST.
  rcm            Boolean                     @default(false)
  taxable        Decimal                     @db.Decimal(14, 2)
  cgst           Decimal                     @default(0) @db.Decimal(14, 2)
  sgst           Decimal                     @default(0) @db.Decimal(14, 2)
  igst           Decimal                     @default(0) @db.Decimal(14, 2)
  roundOff       Decimal                     @default(0) @db.Decimal(6, 2)
  /// Bill value (taxable + GST unless RCM + round-off)
  total          Decimal                     @db.Decimal(14, 2)
  tdsSection     String?
  tdsRate        Decimal                     @default(0) @db.Decimal(5, 2)
  tdsAmount      Decimal                     @default(0) @db.Decimal(14, 2)
  tcsAmount      Decimal                     @default(0) @db.Decimal(14, 2)
  /// What we owe the supplier for this bill: total − TDS + TCS
  payable        Decimal                     @db.Decimal(14, 2)
  paid           Decimal                     @default(0) @db.Decimal(14, 2)
  /// Supplier debit notes applied against this bill
  debitNoted     Decimal                     @default(0) @db.Decimal(14, 2)
  status         PurchaseBillStatus          @default(OPEN)
  notes          String?
  cancelReason   String?
  createdById    String
  createdAt      DateTime                    @default(now())
  lines          PurchaseBillLine[]
  receipts       MaterialReceipt[]
  allocations    SupplierPaymentAllocation[]
  debitNotes     SupplierDebitNote[]

  @@unique([tenantId, number])
  @@unique([tenantId, supplierId, supplierBillNo])
  @@index([tenantId, supplierId, status])
}

model PurchaseBillLine {
  id               String                  @id @default(cuid())
  billId           String
  bill             PurchaseBill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  materialId       String?
  material         Material?               @relation(fields: [materialId], references: [id])
  expenseAccountId String?
  description      String
  hsn              String?
  quantity         Decimal                 @db.Decimal(14, 3)
  unit             String
  rate             Decimal                 @db.Decimal(14, 4)
  gstRate          Decimal                 @db.Decimal(5, 2)
  taxable          Decimal                 @db.Decimal(14, 2)
  tax              Decimal                 @db.Decimal(14, 2)
  total            Decimal                 @db.Decimal(14, 2)
  /// Matching snapshot (material bills): quantity and value received on the attached GRNs
  grnQty           Decimal?                @db.Decimal(14, 3)
  grnValue         Decimal?                @db.Decimal(14, 2)
  /// Booked to inventory beyond the GRN value (rate variance on received qty); revalues the moving average
  inventoryAdj     Decimal                 @default(0) @db.Decimal(14, 2)
  /// Billed but not received — held as a claim on the supplier until a debit note
  claimQty         Decimal                 @default(0) @db.Decimal(14, 3)
  claimValue       Decimal                 @default(0) @db.Decimal(14, 2)
  debitNoteLines   SupplierDebitNoteLine[]
}

model SupplierPayment {
  id          String                      @id @default(cuid())
  tenantId    String
  number      String
  supplierId  String
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  amount      Decimal                     @db.Decimal(14, 2)
  mode        PaymentMode
  reference   String?
  paidAt      DateTime                    @default(now())
  notes       String?
  allocations SupplierPaymentAllocation[]
  createdAt   DateTime                    @default(now())

  @@unique([tenantId, number])
}

model SupplierPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billId    String
  bill      PurchaseBill    @relation(fields: [billId], references: [id])
  amount    Decimal         @db.Decimal(14, 2)
}

enum SupplierNoteReason {
  SHORT_SUPPLY // billed more than received
  RATE_DIFFERENCE // billed above the agreed rate
  OTHER // quality claim, damage…
}

/// Debit note we raise on a supplier (reduces what we owe and the ITC claimed).
model SupplierDebitNote {
  id           String                  @id @default(cuid())
  tenantId     String
  number       String // SDN/26-27/0001
  billId       String
  bill         PurchaseBill            @relation(fields: [billId], references: [id])
  supplierId   String
  supplier     Supplier                @relation(fields: [supplierId], references: [id])
  reason       SupplierNoteReason
  reasonText   String?
  issueDate    DateTime                @default(now())
  taxable      Decimal                 @db.Decimal(14, 2)
  cgst         Decimal                 @default(0) @db.Decimal(14, 2)
  sgst         Decimal                 @default(0) @db.Decimal(14, 2)
  igst         Decimal                 @default(0) @db.Decimal(14, 2)
  total        Decimal                 @db.Decimal(14, 2)
  applied      Decimal                 @default(0) @db.Decimal(14, 2)
  status       NoteStatus              @default(ISSUED)
  cancelReason String?
  createdById  String
  createdAt    DateTime                @default(now())
  lines        SupplierDebitNoteLine[]

  @@unique([tenantId, number])
}

model SupplierDebitNoteLine {
  id          String            @id @default(cuid())
  noteId      String
  note        SupplierDebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  billLineId  String
  billLine    PurchaseBillLine  @relation(fields: [billLineId], references: [id])
  description String
  quantity    Decimal?          @db.Decimal(14, 3)
  rate        Decimal           @db.Decimal(14, 4)
  gstRate     Decimal           @db.Decimal(5, 2)
  taxable     Decimal           @db.Decimal(14, 2)
  tax         Decimal           @db.Decimal(14, 2)
  total       Decimal           @db.Decimal(14, 2)
}

// ───────────────────────── Platform billing (plant owners pay onrmc) ─────────────────────────

/// Single row (id = "platform"): how owners can pay, gateway credentials (encrypted), invoice seller details, lifecycle.
model PlatformSettings {
  id                 String   @id @default("platform")
  // manual (UPI / bank transfer, verified by super admin)
  manualEnabled      Boolean  @default(true)
  upiId              String?
  upiQr              String?  @db.Text // data URL (PNG/JPEG), shown to owners
  bankAccountName    String?
  bankAccountNo      String?
  bankIfsc           String?
  bankName           String?
  bankBranch         String?
  instructions       String?
  // Razorpay
  razorpayEnabled    Boolean  @default(false)
  razorpayKeyId      String?
  razorpaySecretEnc  String?  @db.Text
  razorpayWebhookEnc String?  @db.Text
  // Cashfree
  cashfreeEnabled    Boolean  @default(false)
  cashfreeEnv        String   @default("sandbox") // sandbox | production
  cashfreeAppId      String?
  cashfreeSecretEnc  String?  @db.Text
  cashfreeWebhookEnc String?  @db.Text
  // seller details on subscription tax invoices
  sellerLegalName    String   @default("onrmc Technologies Pvt Ltd")
  sellerGstin        String?
  sellerStateCode    String   @default("36")
  sellerAddress      String?
  sellerPincode      String?
  sacCode            String   @default("998314")
  gstRate            Decimal  @default(18) @db.Decimal(5, 2)
  // lifecycle
  graceDays          Int      @default(7)
  reminderDays       Int      @default(7)
  updatedAt          DateTime @updatedAt
}

enum SubscriptionPaymentMethod {
  MANUAL
  RAZORPAY
  CASHFREE
}

enum SubscriptionPaymentStatus {
  CREATED // gateway order created, not paid yet
  PENDING_VERIFICATION // manual payment submitted, awaiting super admin
  PAID
  REJECTED
  FAILED
}

model SubscriptionPayment {
  id               String                    @id @default(cuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id])
  planId           String
  plan             Plan                      @relation(fields: [planId], references: [id])
  billingCycle     String // MONTHLY | YEARLY
  months           Int
  /// Amounts are always computed on the server from the plan price.
  taxable          Decimal                   @db.Decimal(12, 2)
  cgst             Decimal                   @default(0) @db.Decimal(12, 2)
  sgst             Decimal                   @default(0) @db.Decimal(12, 2)
  igst             Decimal                   @default(0) @db.Decimal(12, 2)
  total            Decimal                   @db.Decimal(12, 2)
  method           SubscriptionPaymentMethod
  status           SubscriptionPaymentStatus
  reference        String? // UTR / bank reference (manual)
  paidOn           DateTime?
  screenshot       String?                   @db.Text // data URL
  rejectReason     String?
  gatewayOrderId   String?                   @unique
  gatewayPaymentId String?
  raw              Json?
  verifiedById     String?
  verifiedAt       DateTime?
  submittedById    String
  createdAt        DateTime                  @default(now())
  invoice          SubscriptionInvoice?

  @@index([status])
  @@index([tenantId])
}

/// onrmc's GST tax invoice to the plant owner for a subscription payment.
model SubscriptionInvoice {
  id             String              @id @default(cuid())
  number         String              @unique // SUB/26-27/0001
  paymentId      String              @unique
  payment        SubscriptionPayment @relation(fields: [paymentId], references: [id])
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  issueDate      DateTime            @default(now())
  seller         Json // snapshot: legal name, GSTIN, state, address
  buyerName      String
  buyerGstin     String?
  buyerStateCode String
  buyerAddress   String?
  placeOfSupply  String
  interState     Boolean
  description    String
  sac            String
  gstRate        Decimal             @db.Decimal(5, 2)
  taxable        Decimal             @db.Decimal(12, 2)
  cgst           Decimal             @default(0) @db.Decimal(12, 2)
  sgst           Decimal             @default(0) @db.Decimal(12, 2)
  igst           Decimal             @default(0) @db.Decimal(12, 2)
  total          Decimal             @db.Decimal(12, 2)
}

/// Platform-wide gap-free number series (subscription invoices).
model PlatformSeries {
  key  String @id
  next Int    @default(1)
}

/// Gateway webhook deliveries already processed (idempotency).
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}
